' ===========================================================================
'  3 of 7 — THE TRACKING PIPELINE
'  Everything inside run_tracking_job(). This is the heart of the app.
' ===========================================================================
@startuml tracking_pipeline
title The tracking pipeline — job_runner.run_tracking_job()\n<size:11>//The heart of the app. Runs on one daemon thread, one job at a time.//</size>

skinparam shadowing false
skinparam ArrowFontSize 11

start

:acquire TRACKING_JOB_SEMAPHORE(1);
note right
  Global: <b>one tracking job at a time</b>.
  A second submit blocks here until the
  first finishes. Not a queue — a lock.
end note

partition "stage = **coarse**" {
  :get_tracking_model()
  <size:10>cached singleton — the first call downloads</size>
  <size:10>RF-DETR and may take a minute</size>;

  :**Coarse pass** — whole clip at frame_stride
  <size:10>track_segments() at COARSE_INFERENCE_WIDTH=640</size>
  <size:10>when stride > 1 — good enough to LOCATE hits</size>;
  note right
    Two threads inside every pass:
    a decode producer feeding a
    Queue(maxsize=8), and an inference
    consumer. Strided-out frames use
    cap.grab() to skip BGR decode.
  end note

  :write ball_coordinates.csv;

  :**Audio analysis**
  <size:10>fusion → extract_repeating_audio_windows()</size>
  <size:10>else → extract_audio_candidates()</size>;

  :**Find hit candidates** — detect_hits_from_rows()
  <size:10>only to decide WHERE to look closely</size>;
}

if (frame_stride > 1 and candidates found?) then (yes)
  partition "stage = **refine**" {
    :**Refine pass** — stride 1 around each candidate
    <size:10>±max(12, 4×stride) frames, merged with audio</size>
    <size:10>windows ±4, re-tracked at the full inference_width</size>;
    :rewrite ball_coordinates.csv;
  }
else (no — already dense)
endif

if (audio windows with ZERO nearby detections?) then (yes)
  :**Audio rescue** — re-track just those windows
  at width max(inference_width, 1600)
  <size:10>an event with no ball position cannot be judged</size>;
else (no)
endif

partition "stage = **judging**" {
  :**Detect bounces** with the selected engine
  <size:10>gb_model (default) | votes | fusion</size>;
  if (engine == fusion?) then (yes)
    :engine already emitted event_type;
  else (no)
    :**classify_events()** → wall / racket / unknown;
  endif

  :**judge_hits()**;
  note right
    Per event:
    • not a front-wall hit → call = None,
      reason = "classified_as_{type}"
      (<b>verdicts are front-wall-only</b>)
    • judged point = fitted impact if present,
      else the detected box centre
    • judge_ball() vs the two tapped lines →
      IN / OUT + a signed pixel margin
  end note

  :**Analytics** — target zones, rallies,
  player assignment, floor zones;
}

:status = **complete**, stage = complete;
stop

legend right
  <b>Two levels of error handling, on purpose:</b>

  <b>Inner</b> — a failure in detect/classify/judge is caught,
  stored as job["hits_error"], and the run still completes.
  A judging bug must not throw away a finished tracking pass.

  <b>Outer</b> — anything else → status="failed" + error text.

  <b>Crash recovery</b> — get_job() reads job.json when the run
  is not in memory. A job still marked queued/running on disk
  but absent from JOBS provably died with the process, so it
  is rewritten as failed rather than polled forever.
endlegend

@enduml


' ===========================================================================
'  4 of 7 — JUDGE A CLIP (the request flow)
'  The path a newcomer hits first.
' ===========================================================================
@startuml judge_a_clip
title Judge a clip — the request flow\n<size:11>//Upload → track → poll → judge → correct//</size>

skinparam shadowing false
skinparam ArrowFontSize 11
autonumber "<b>[0]"

actor Player
participant "index.html\n<size:10>browser</size>" as UI
participant "app.py\n<size:10>Flask</size>" as API
participant "job thread\n<size:10>job_runner</size>" as JOB
database "ui_runs/\n<size:10>{run_id}/</size>" as FS

== Calibration (all client-side) ==
Player -> UI : tap the OUT line, the TIN,\nthe 4 wall corners, floor landmarks
activate UI
UI -> UI : HSV flood fill → RANSAC line fit\n→ DLT homography\n<size:10>plain JS. No ML in the browser.</size>
UI -> API : POST /api/camera-check\n<size:10>debounced 400 ms after each tap</size>
API --> UI : solve health: ok / warn / fail
deactivate UI

== Submit ==
Player -> UI : tap **Track ball**
UI -> API : POST /api/upload  <size:10>(multipart, XHR for progress)</size>
activate API
API -> FS : stream to disk in 1 MB chunks,\nhashing SHA-256 as it goes
API --> UI : {video_id, fps, frame_count}
note right of API
  Content-addressed:
  uploads/by-hash/{sha256}.mp4
  Re-uploading the same clip is free.
end note
deactivate API

UI -> API : POST /api/track\n<size:10>video_id, calibration_json, start/end,</size>\n<size:10>frame_stride, inference_width, event_engine</size>
activate API
API -> FS : mkdir {run_id}/ + write calibration.json
API -> JOB : start_tracking_job()\n<size:10>threading.Thread(daemon=True)</size>
API --> UI : {run_id, status:"queued"}
deactivate API
UI -> UI : setPhase('analyze')

== Poll (no websockets, no SSE) ==
activate JOB
loop every 500 ms until complete or failed
  UI -> API : GET /api/track/status/{run_id}
  API --> UI : {status, stage, processed_frames,\ntotal_frames, progress, message}
  UI -> UI : update the progress bar and seek the\npreview video to the frame being worked on
end
JOB -> FS : job.json rewritten every ~0.5 s\n<size:10>tmp file + os.replace = atomic</size>
JOB -> FS : ball_coordinates.csv, detected_hits.json
deactivate JOB

UI -> UI : setPhase('track')  — the Call page

== Review and correct ==
UI -> API : GET ball_coordinates.csv + corrections
UI -> API : POST /api/judge  {run_id, frame}\n<size:10>on demand, or 300 ms after a scrub settles</size>
API --> UI : {call: "IN"|"OUT", reason, margin_px, ...}
Player -> UI : disagree → drag the ball dot,\nfix the hit type or the frame
UI -> API : POST /api/runs/{run_id}/corrections
API -> FS : corrections.json  <size:10>(schema corrections-v2)</size>
note over FS, API
  These corrections are not just a UI nicety —
  build_eval_set.py distills them into the
  committed eval corpus. Correcting a call is
  how the project gets better.
end note

@enduml


