# Secrets — never commit API keys
.env

# Python build/cache junk
__pycache__/
*.pyc

# Tool caches
.matplotlib-cache/
.roboflow-cache/

# App output (uploaded videos, tracking results)
ui_runs/

# Local usage/metrics database
usage.db

.venv/
# Local virtualenv (this checkout uses venv/ not .venv/)
venv/

# Temporary project whitelist: only Python and HTML source files should appear
# as new untracked files.
*
!*/
!*.py
!*.html
!.gitignore
# Agent/design guidelines are durable project docs
!CLAUDE.md
!DESIGN.md
# The distilled eval set is the durable, git-tracked artifact (see
# build_eval_set.py) — ui_runs stays ignored, its distillation doesn't.
!eval_set/*.jsonl
!eval_set/*.json
!eval_set/*.md
# Design specs are durable project docs
!docs/**/*.md
# Architecture diagrams: the .puml source is the durable artifact (rendered
# images are not committed — see docs/ARCHITECTURE.md for how to view them).
!docs/**/*.puml
!hardware/README.md
# Printable mount parts + spec PDF: committed so teammates get them without
# regenerating (source of truth stays the generator + markdown)
!hardware/stl/*.stl
!docs/mount-spec.pdf
# Same deal for the annotation guide: whoever is labeling needs the printable
# PDF, and they are the least likely person to run a build script for it.
!docs/annotation-guide.pdf
!docs/figures/*.svg
!docs/figures/*.png
!bounce_gb_model.pkl
# CI config and the dependency manifests it installs from
!.github/workflows/*.yml
!requirements.txt
!requirements-test.txt
!README.md
!train_bounce_transformer_all_videos.sh
# pytest config (marker registration + default -m deselect); needed by
# everyone running `pytest tests/`, not just CI.
!pytest.ini
# Offline label sets from label_hits.py: the CSV plus the sidecar that says
# which video its frame numbers index into. Small, and the eval set needs them.
# Exact suffix, so scratch copies ("wall_hits copy.csv") stay ignored.
!*wall_hits.csv
!*wall_hits.meta.json
# The archived two-camera stereo/peer feature (archive/stereo/README.md).
# Whitelisted in full and deliberately so: the whole point of archiving rather
# than deleting is that every line stays in the tree and stays findable. It is
# inert by construction, not by being untracked — pytest ignores it, no runtime
# module imports it, and ios/project.yml does not list it as a source.
!archive/**
# The exported WASB temporal ball model (6.4 MB traced TorchScript + its
# ball-model-v2 manifest). Committed deliberately, unlike the YOLOX artifact
# (models/crosscourt-ball-416-v1 stays ignored): teammates cannot regenerate
# this one -- the checkpoint, training scripts, and CUDA env live only on the
# training box -- and the serving pipeline needs the directory to run with
# BALL_MODEL_DIR. The manifest's artifact_sha256 pins the binary.
!models/crosscourt-wasb-416-v1/manifest.json
!models/crosscourt-wasb-416-v1/model.torchscript

# Native iOS app and deploy artifacts (ios/.gitignore re-excludes the
# generated .xcodeproj and Info.plist)
!ios/**
!deploy/**
# Re-stated after the whitelist above (last match wins): the blanket !ios/**
# and !deploy/** must never make secrets or junk trackable inside those trees.
.env
.DS_Store
__pycache__/
*.pyc
usage.db

# Claude Code worktrees for spawned background tasks (last: must beat the !*.py whitelist)
.claude/worktrees/

# Virtualenvs, re-stated last: the `!*/` above re-includes every directory,
# which silently un-ignored the rules near the top of this file.
.venv/
venv/
