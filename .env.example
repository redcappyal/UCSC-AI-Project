ROBOFLOW_API_KEY=replace_with_your_key
ROBOFLOW_WORKSPACE=reds-workspace-oc87h
ROBOFLOW_PROJECT_ID=squashai
ROBOFLOW_PACKAGE_NAME=squashai-3-rfdetr-small-t1
ROBOFLOW_MODEL_ID=squashai/1
# Hosted racket-video evaluator (racket_model_eval.py)
RACKET_WORKFLOW_API_KEY=replace_with_your_full_key
RACKET_WORKFLOW_WORKSPACE=alvins-workspace-vzjhh
RACKET_WORKFLOW_ID=racketdetection-2
COACH_LLM_PROVIDER=ollama
OLLAMA_COACH_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ball detector for analysis jobs. local (default) = the committed WASB
# temporal model in models/crosscourt-wasb-416-v1; rfdetr = the hosted
# Roboflow RF-DETR (needs ROBOFLOW_API_KEY). No silent fallback.
#BALL_DETECTOR=local
# Device for the local ball detector: auto (default; CUDA if available,
# else CPU — never auto-MPS), cpu, cuda, or mps (opt-in).
#BALL_DEVICE=auto
# Override the local ball model directory (defaults to the committed WASB).
#BALL_MODEL_DIR=
